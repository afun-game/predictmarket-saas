# Environment Configuration

# Application
APP_ENV=development
APP_PORT=8080

# Database
DATABASE_URL=postgres://predictmarket:password@localhost:5432/predictmarket?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# NATS JetStream
NATS_URL=nats://localhost:4222

# Polymarket API
POLYMARKET_API_URL=https://gamma-api.polymarket.com
POLYMARKET_SYNC_INTERVAL=@every 5m

# Exchange Rate Provider
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=predictmarket-saas

# Admin API Key (for internal operations)
ADMIN_API_KEY=admin_secret_key_change_in_production
