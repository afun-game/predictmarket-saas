# Environment Configuration

# Application
APP_ENV=development
APP_PORT=8080

# Database
DATABASE_URL=postgres://predictmarket:password@localhost:5432/predictmarket?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# NATS JetStream
NATS_URL=nats://localhost:4222

# Polymarket API
POLYMARKET_API_URL=https://gamma-api.polymarket.com
POLYMARKET_SYNC_INTERVAL=@every 5m

# Official LMB calendar ingestion (run by the independent sports-ingest process)
# LMB_CALENDAR_TIMEZONE is the verified API query-day contract. Market business
# and display rules are fixed to Mexico City; persisted timestamps remain UTC.
LMB_BASE_URL=https://lmb.com.mx
LMB_CALENDAR_TIMEZONE=Asia/Shanghai
LMB_MARKET_TIMEZONE=America/Mexico_City
LMB_REQUEST_TIMEOUT=15s
SPORTS_INGEST_POLL_INTERVAL=5m
SPORTS_INGEST_LOOKAHEAD_DAYS=7
SPORTS_INGEST_RUN_ONCE=false

# Exchange Rate Provider
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=predictmarket-saas

# Admin API Key (for internal operations)
ADMIN_API_KEY=admin_secret_key_change_in_production

# Admin console (enabled together with the V3 stack; /admin is served when
# SESSION_JWT_SECRET is set). ADMIN_USERNAME/ADMIN_PASSWORD bootstrap the first
# super-admin account when no admin account exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# Market maker: turns binary-market liquidity_pool into two-sided quotes
# around the book mid. Enabled by default; schedule is a cron expression.
MARKET_MAKER_ENABLED=true
MARKET_MAKER_SCHEDULE=@every 10s
MARKET_MAKER_HALF_SPREAD=0.05
MARKET_MAKER_LEVEL_FRACTION=0.25
MARKET_MAKER_MIN_FUNDS=100
MARKET_MAKER_STOP_BEFORE_MINUTES=5

# V3 hosted UI (set all three values or V3 routes remain disabled)
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MERCHANT_SECRET_ENCRYPTION_KEY=
SESSION_JWT_SECRET=
HOSTED_UI_URL=

# Process-wide API ceiling per window (requests/minute, default 600). Raise it
# for load/acceptance runs against the sandbox.
GLOBAL_RATE_LIMIT=

# V3 layered rate limits per window (requests/minute, per merchant key or
# browser session). Defaults: 120 order writes, 600 queries, 300 session calls.
V3_ORDER_RATE_LIMIT=
V3_QUERY_RATE_LIMIT=
V3_USER_RATE_LIMIT=

# Sandbox only: allow callback targets on private hosts (loopback for local
# seamless testing). Never enable in production.
V3_ALLOW_PRIVATE_CALLBACK_URLS=
